{
  "name": "harness-enforcement",
  "description": "Enforcement plugin for Harness skills - adds hard gates for verification and circuit breaker in opencode",
  "version": "0.3.6",
  "author": "Miya Daniel",
  "license": "Apache-2.0",
  "hooks": {
    "postEdit": "hooks/post-edit.js",
    "preComplete": "hooks/pre-complete.js"
  },
  "onDemandHooks": {
    "verify": "hooks/verify.js",
    "circuitBreaker": "hooks/circuit-breaker.js",
    "compliance": "hooks/compliance.js"
  },
  "config": {
    "verificationRequired": true,
    "circuitBreakerEnabled": true,
    "maxRetries": 3,
    "verificationCommands": ["npm test", "npm run lint", "npm run build"]
  }
}
