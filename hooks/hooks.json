{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/harness-everything/scripts/bootstrap.js\""
          }
        ],
        "description": "Bootstrap Harness Skills OS on session start",
        "id": "harness:pre:bootstrap"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/harness-everything/scripts/kernel-router.js\""
          }
        ],
        "description": "Establish Harness routing invariants and an active workflow execution contract before host/domain skill selection",
        "id": "harness:pre:kernel-router"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/workflow-gate.js\""
          }
        ],
        "description": "Enforce mandatory workflow entry and Tier 3 Git-worktree mutation isolation",
        "id": "harness:pre:workflow-gate"
      },
      {
        "matcher": "Bash|PowerShell|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/action-gate.js\""
          }
        ],
        "description": "Require explicit approval for destructive or external side effects",
        "id": "harness:pre:action-gate"
      },
      {
        "matcher": "Bash|PowerShell|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/rule-of-3.js\""
          }
        ],
        "description": "Rule of 3 Circuit Breaker - Prevents micro-error looping",
        "id": "harness:pre:rule-of-3"
      },
      {
        "matcher": "Grep|Glob|Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/boundary-guard.js\""
          }
        ],
        "description": "Physical boundary enforcement for searches and large file reads",
        "id": "harness:pre:boundary-guard"
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/depth-guard.js\""
          }
        ],
        "description": "Information depth guard - Enforce impact assessment before writing code",
        "id": "harness:pre:depth-guard"
      },
      {
        "matcher": "Edit|Write|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/context-compact.js\""
          }
        ],
        "description": "Strategic context compaction enforcement",
        "id": "harness:pre:context-compact"
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/subagent-scope-guard.js\""
          }
        ],
        "description": "Snapshot repo state before a subagent burst starts",
        "id": "harness:pre:subagent-scope-guard"
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/telemetry-adapter.js\""
          }
        ],
        "description": "Record privacy-safe Harness skill load start telemetry",
        "id": "harness:pre:skill-telemetry"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/action-gate.js\""
          }
        ],
        "description": "Close any unexecuted action-gate approvals as rejected for this turn",
        "id": "harness:stop:action-gate-audit"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/workflow-stop-gate.js\""
          }
        ],
        "description": "Prevent completion while a selected Fable workflow has not reached verified stage resolution",
        "id": "harness:stop:workflow-completion-gate"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/stop-gate.js\""
          }
        ],
        "description": "Pre-delivery gate - bounce the end of a turn once per edit batch when edits were never verified",
        "id": "harness:stop:stop-gate"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/telemetry-adapter.js\""
          }
        ],
        "description": "Close Harness skill active-window telemetry at the turn boundary",
        "id": "harness:stop:skill-telemetry"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/action-gate.js\""
          }
        ],
        "description": "Record execution of an approved action-gate payload",
        "id": "harness:post:action-gate-audit"
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/rule-of-3-tracker.js\""
          }
        ],
        "description": "Track error signatures for Rule of 3",
        "id": "harness:post:rule-of-3-tracker"
      },
      {
        "matcher": "Edit|Write|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/workflow-mutation-observer.js\""
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/state-persist.js\""
          }
        ],
        "description": "Observe workspace mutation before saving skill transition state",
        "id": "harness:post:state-persist"
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/atomic-commit-check.js\""
          }
        ],
        "description": "Atomic commit enforcement",
        "id": "harness:post:atomic-commit-check"
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/contract-test.js\""
          }
        ],
        "description": "Contract testing between sub-agents",
        "id": "harness:post:contract-test"
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/subagent-scope-guard.js\""
          }
        ],
        "description": "Diff the whole repo after a subagent burst finishes - catches scope creep past what the task briefed",
        "id": "harness:post:subagent-scope-guard"
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/telemetry-adapter.js\""
          }
        ],
        "description": "Record privacy-safe Harness skill load completion telemetry",
        "id": "harness:post:skill-telemetry"
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|PowerShell|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/action-gate.js\""
          }
        ],
        "description": "Record that an approved action-gate payload executed but failed",
        "id": "harness:post-failure:action-gate-audit"
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/rule-of-3-tracker.js\""
          }
        ],
        "description": "Track failed tool error signatures for Rule of 3",
        "id": "harness:post-failure:rule-of-3-tracker"
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/workflow-mutation-observer.js\""
          }
        ],
        "description": "Observe workspace effects from failed shell commands",
        "id": "harness:post-failure:workflow-mutation-observer"
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/telemetry-adapter.js\""
          }
        ],
        "description": "Record failed Harness skill loading without prompt/tool arguments",
        "id": "harness:post-failure:skill-telemetry"
      }
    ]
  }
}
