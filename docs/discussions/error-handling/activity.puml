@startuml error-handling-overview
' Issue #437 / #402: discussion-only view of one Error Occurrence.
' ASSESS / RESPOND correspond to Views 1 and 2.
' Decide disposition is expanded by View 3, not a hyperlink.
' Recurrence is a NEW occurrence entering at Capture, never a G feedback loop.
title Error Handling — one occurrence (UML Activity draft)

start
:New Error Occurrence;
partition "ASSESS" {
  :Capture;
  :Triage;
  if (Already-approved tolerate class?) then (yes)
    :Retry this operation (at most 3);
    if (Recovered?) then (yes)
      :Resume interrupted work;
    else (no)
      :Mark step UNVERIFIED;
      :Report; continue independent work only;
    endif
    stop
  else (no)
    if (Real problem, according to reviewer?) then (yes)
      :Identify;
      if (Identification complete?) then (yes)
        if (Blocking main path?) then (no)
          :Record / defer treatment;
          stop
        endif
      else (no / owner decision pending)
        :Hold pending identification decision;
        stop
      endif
    else (no / unclear)
      if (Reviewer cannot tell?) then (yes)
        :Request owner decision; hold item;
      else (no)
        :Dismiss with reason;
      endif
      stop
    endif
  endif
}

partition "RESPOND" {
  :Decide disposition
  <b>expanded in View 3</b>;
  if (Mechanical prevention feasible within budget?) then (yes)
    if (Same class still yields new instances in bounded review?) then (yes)
      :Consider Avoid / Tolerate;
    else (no)
      :Converge;
    endif
  else (no)
    :Consider Avoid / Tolerate;
  endif
  if (Avoid or Tolerate under consideration?) then (yes)
    if (Can drop or restrict action?) then (yes)
      :Avoid;
    else (no)
      if (Owner approves Tolerate?) then (yes)
        :Tolerate;
      else (no / pending)
        :Keep unresolved; do not bypass required checks;
        stop
      endif
    endif
  endif
  :Treat (define acceptance first);
  :Deliver relevant context;
  :Accept and retire;
  if (Converge / Avoid: acceptance met?) then (yes)
    :Accept; retire unneeded lesson;
  else (no)
    if (Tolerate: cap and escalation recorded?) then (yes)
      :Keep tolerate class active;
    else (no)
      :Keep open; report outstanding evidence;
    endif
  endif
}

stop
@enduml
