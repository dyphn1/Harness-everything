{
  "name": "harness-everything",
  "version": "0.3.6",
  "description": "Harness OS: An Orchestrated Agent Operating System for AI-driven Development",
  "main": "harness-everything/scripts/bootstrap.js",
  "bin": {
    "harness": "./bin/cli.js"
  },
  "scripts": {
    "test": "node self-evolve/scripts/self-regression.js",
    "self-regression": "node self-evolve/scripts/self-regression.js",
    "test:mechanism": "node ci/mechanism-test.js",
    "test:consistency": "node ci/consistency-check.js",
    "test:references": "node ci/reference-check.js",
    "test:release": "node ci/release-consistency-check.js --tag v0.3.3-beta",
    "test:install": "node scripts/verify-install.js",
    "test:collision": "node ci/description-collision.js",
    "test:routing:skills": "node ci/skill-routing-check.js",
    "test:routing": "node ci/routing-check.js",
    "benchmark:scaffold": "node benchmarks/run.js scaffold",
    "benchmark:status": "node benchmarks/run.js status",
    "eval:behavioral": "node behavioral-evals/run.js run",
    "eval:behavioral:validate": "node behavioral-evals/run.js validate",
    "eval:behavioral:plugin": "node behavioral-evals/run-with-plugin.js run",
    "test:ab": "node ci/ab-test-harness.js validate",
    "test:ab:run": "node ci/ab-test-harness.js run",
    "harness:reset": "node hooks/scripts/reset-circuit-breaker.js",
    "prepare": "husky install",
    "commitlint": "commitlint --edit"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "Miya Daniel",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dyphn1/Harness-everything.git"
  },
  "homepage": "https://github.com/dyphn1/Harness-everything#readme",
  "bugs": {
    "url": "https://github.com/dyphn1/Harness-everything/issues"
  },
  "devDependencies": {
    "js-yaml": "^5.4.1",
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "husky": "^9.0.0"
  }
}
