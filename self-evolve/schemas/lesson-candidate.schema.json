{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dyphn1/Harness-everything/self-evolve/schemas/lesson-candidate.schema.json",
  "title": "Harness Lesson Candidate",
  "type": "object",
  "required": [
    "schemaVersion",
    "candidateId",
    "contentHash",
    "state",
    "trigger",
    "provenance",
    "evidence",
    "generalizedRule",
    "scope",
    "screening",
    "evaluation",
    "persistence",
    "outcome",
    "history",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "candidateId": { "type": "string", "pattern": "^lesson-[a-f0-9]{24}$" },
    "contentHash": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "state": {
      "enum": [
        "proposed",
        "screened",
        "evaluated",
        "accepted",
        "rejected",
        "inconclusive",
        "persisted",
        "retrieved",
        "validated",
        "regressed",
        "superseded"
      ]
    },
    "trigger": {
      "type": "object",
      "required": ["type", "reasonCodes", "sourceEventIds", "evidenceClass"],
      "properties": {
        "type": { "enum": ["rule-of-3-recovery", "verifier-fail-pass"] },
        "reasonCodes": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "sourceEventIds": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "evidenceClass": { "enum": ["runtime-recovery", "objective-transition"] }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["sessionId", "workflowId", "runId", "strategy"],
      "properties": {
        "sessionId": { "type": ["string", "null"] },
        "workflowId": { "type": ["string", "null"] },
        "runId": { "type": ["string", "null"] },
        "strategy": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "evidence": { "type": "object" },
    "generalizedRule": { "type": ["string", "null"] },
    "scope": {
      "type": "object",
      "required": ["task", "requirement", "role"],
      "properties": {
        "task": { "type": ["string", "null"] },
        "requirement": { "type": ["string", "null"] },
        "role": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "screening": { "type": ["object", "null"] },
    "evaluation": { "type": ["object", "null"] },
    "persistence": { "type": ["object", "null"] },
    "outcome": { "type": ["object", "null"] },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["state", "observedAt", "reasonCode"],
        "properties": {
          "state": { "type": "string" },
          "observedAt": { "type": "string", "format": "date-time" },
          "reasonCode": { "type": "string" },
          "evidenceRef": { "type": ["string", "null"] }
        }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
