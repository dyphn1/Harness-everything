{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dyphn1/Harness-everything/contract-integrity/schemas/trace.schema.json",
  "title": "Harness Contract Integrity Trace",
  "type": "object",
  "required": ["schemaVersion", "mode", "artifacts", "requirements", "probes"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "mode": { "enum": ["audit", "strict"] },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "path", "status", "revision"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["ADR", "SPEC", "TICKET", "TEST", "IMPLEMENTATION"] },
          "path": { "type": "string", "minLength": 1 },
          "status": { "enum": ["ACTIVE", "SUPERSEDED", "DEPRECATED"] },
          "revision": { "type": "integer", "minimum": 1 },
          "requirementId": { "type": ["string", "null"] },
          "requirementRevision": { "type": ["integer", "null"], "minimum": 1 },
          "changeImpact": { "enum": ["none", "implementation", "behavior", "architecture"] },
          "supersedes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "evidenceRef": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "requirementId", "revision", "status", "specId", "decisionIds",
          "ticketIds", "testIds", "implementationIds", "requiredProbeIds", "sourceValidity"
        ],
        "properties": {
          "requirementId": { "type": "string", "minLength": 1 },
          "revision": { "type": "integer", "minimum": 1 },
          "status": { "enum": ["CURRENT", "SUPERSEDED"] },
          "specId": { "type": "string", "minLength": 1 },
          "decisionIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "ticketIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "testIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "implementationIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "requiredProbeIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "sourceValidity": { "enum": ["VALID", "SOURCE_DEFECT", "SOURCE_CONFLICT"] },
          "supersededBy": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "probes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "probeId", "requirementId", "status", "sourceSection",
          "evidenceRef", "workspaceIsolation", "failureClass"
        ],
        "properties": {
          "probeId": { "type": "string", "minLength": 1 },
          "requirementId": { "type": "string", "minLength": 1 },
          "status": { "enum": ["KILLED", "SURVIVED", "INVALID", "NOT_EVALUATED"] },
          "sourceSection": { "type": "string", "minLength": 1 },
          "evidenceRef": { "type": ["string", "null"] },
          "workspaceIsolation": { "enum": ["isolated", "not-isolated", "unknown"] },
          "failureClass": { "enum": ["contract", "build", "infrastructure", "flaky", "none", "unknown"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
