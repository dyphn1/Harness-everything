{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dyphn1/Harness-everything/verification-loop/references/verify-contract.schema.json",
  "title": "Harness project verification contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "checks"],
  "properties": {
    "version": { "const": 1 },
    "roots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "run"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "run": { "type": "string", "minLength": 1 },
          "cwd": { "type": "string", "minLength": 1, "default": "." },
          "timeoutSec": { "type": "integer", "minimum": 1, "maximum": 3600, "default": 600 }
        }
      }
    }
  }
}
