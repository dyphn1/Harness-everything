{
  "description": "Harness invariant-first routing and compact Cognitive OS policy for ChatGPT/Codex.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/session-start.js\"",
            "commandWindows": "node \"${PLUGIN_ROOT}\\hooks\\session-start.js\"",
            "timeout": 15,
            "statusMessage": "Loading Harness cognitive policy",
            "additionalContextLimit": 800
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/skills/harness-everything/scripts/kernel-router.js\"",
            "commandWindows": "node \"${PLUGIN_ROOT}\\skills\\harness-everything\\scripts\\kernel-router.js\"",
            "timeout": 30,
            "statusMessage": "Routing with Harness workflow contract",
            "additionalContextLimit": 2500
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/scripts/workflow-gate.js\"",
            "commandWindows": "node \"${PLUGIN_ROOT}\\hooks\\scripts\\workflow-gate.js\"",
            "timeout": 15,
            "statusMessage": "Checking Harness workflow and worktree-isolation contract"
          }
        ]
      },
      {
        "matcher": "Bash|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/scripts/codex-action-gate-pre.js\"",
            "commandWindows": "node \"${PLUGIN_ROOT}\\hooks\\scripts\\codex-action-gate-pre.js\"",
            "timeout": 15,
            "statusMessage": "Checking Harness pre-action approval gate"
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/scripts/rule-of-3.js\"",
            "commandWindows": "node \"${PLUGIN_ROOT}\\hooks\\scripts\\rule-of-3.js\"",
            "timeout": 15,
            "statusMessage": "Checking Harness circuit breaker"
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/scripts/context-compact.js\"",
            "commandWindows": "node \"${PLUGIN_ROOT}\\hooks\\scripts\\context-compact.js\"",
            "timeout": 15,
            "statusMessage": "Checking Harness context size"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/scripts/subagent-scope-guard.js\"",
            "commandWindows": "node \"${PLUGIN_ROOT}\\hooks\\scripts\\subagent-scope-guard.js\"",
            "timeout": 15,
            "statusMessage": "Recording subagent scope baseline"
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/scripts/codex-action-gate-pre.js\"",
            "commandWindows": "node \"${PLUGIN_ROOT}\\hooks\\scripts\\codex-action-gate-pre.js\"",
            "timeout": 15,
            "statusMessage": "Checking Harness structured MCP action gate"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/scripts/telemetry-adapter.js\"",
            "commandWindows": "node \"${PLUGIN_ROOT}\\hooks\\scripts\\telemetry-adapter.js\"",
            "timeout": 10,
            "statusMessage": "Recording local Harness skill telemetry"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/scripts/codex-permission-request.js\"",
            "commandWindows": "node \"${PLUGIN_ROOT}\\hooks\\scripts\\codex-permission-request.js\"",
            "timeout": 15,
            "statusMessage": "Recording Codex native approval request"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/scripts/codex-action-gate-post.js\"",
            "commandWindows": "node \"${PLUGIN_ROOT}\\hooks\\scripts\\codex-action-gate-post.js\"",
            "timeout": 15,
            "statusMessage": "Recording Harness action-gate execution outcome"
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/scripts/rule-of-3-tracker.js\"",
            "commandWindows": "node \"${PLUGIN_ROOT}\\hooks\\scripts\\rule-of-3-tracker.js\"",
            "timeout": 15,
            "statusMessage": "Recording Harness failure evidence"
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/scripts/state-persist.js\"",
            "commandWindows": "node \"${PLUGIN_ROOT}\\hooks\\scripts\\state-persist.js\"",
            "timeout": 15,
            "statusMessage": "Saving Harness session state"
          }
        ]
      },
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/scripts/atomic-commit-check.js\"",
            "commandWindows": "node \"${PLUGIN_ROOT}\\hooks\\scripts\\atomic-commit-check.js\"",
            "timeout": 15,
            "statusMessage": "Checking atomic change boundaries"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/scripts/contract-test.js\"",
            "commandWindows": "node \"${PLUGIN_ROOT}\\hooks\\scripts\\contract-test.js\"",
            "timeout": 15,
            "statusMessage": "Checking Harness stage contract"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/scripts/subagent-scope-guard.js\"",
            "commandWindows": "node \"${PLUGIN_ROOT}\\hooks\\scripts\\subagent-scope-guard.js\"",
            "timeout": 15,
            "statusMessage": "Reviewing subagent scope changes"
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/scripts/codex-action-gate-post.js\"",
            "commandWindows": "node \"${PLUGIN_ROOT}\\hooks\\scripts\\codex-action-gate-post.js\"",
            "timeout": 15,
            "statusMessage": "Recording Harness structured MCP action outcome"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/scripts/telemetry-adapter.js\"",
            "commandWindows": "node \"${PLUGIN_ROOT}\\hooks\\scripts\\telemetry-adapter.js\"",
            "timeout": 10,
            "statusMessage": "Recording local Harness skill telemetry"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/scripts/subagent-start.js\"",
            "commandWindows": "node \"${PLUGIN_ROOT}\\hooks\\scripts\\subagent-start.js\"",
            "timeout": 15,
            "statusMessage": "Loading Harness subagent scope"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/scripts/subagent-stop.js\"",
            "commandWindows": "node \"${PLUGIN_ROOT}\\hooks\\scripts\\subagent-stop.js\"",
            "timeout": 15,
            "statusMessage": "Checking subagent scope changes"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/scripts/action-gate.js\"",
            "commandWindows": "node \"${PLUGIN_ROOT}\\hooks\\scripts\\action-gate.js\"",
            "timeout": 15,
            "statusMessage": "Closing unresolved Harness action approvals"
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/scripts/workflow-stop-gate.js\"",
            "commandWindows": "node \"${PLUGIN_ROOT}\\hooks\\scripts\\workflow-stop-gate.js\"",
            "timeout": 15,
            "statusMessage": "Checking Harness workflow completion gate"
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/scripts/stop-gate.js\"",
            "commandWindows": "node \"${PLUGIN_ROOT}\\hooks\\scripts\\stop-gate.js\"",
            "timeout": 15,
            "statusMessage": "Checking Harness verification gate"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/scripts/telemetry-adapter.js\"",
            "commandWindows": "node \"${PLUGIN_ROOT}\\hooks\\scripts\\telemetry-adapter.js\"",
            "timeout": 10,
            "statusMessage": "Recording local Harness skill telemetry"
          }
        ]
      }
    ]
  }
}
