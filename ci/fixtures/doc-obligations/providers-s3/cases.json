{
  "schemaVersion": 1,
  "phase": "325-3b-S3",
  "description": "S3 advisory provider suggestion cases. Expected outputs are hand-derived from docs/doc-workflow-reconciliation.md (S3 section) and are the RED oracle. The three contract examples live in reconciliation-prep/provider-contract.json and are read directly by the suite. Kinds: valid (exact output with suggestions and unavailable only), malformed (structured invalid-input result). Reason strings: 'active-step capability and host requirements match'; 'host lacks <sorted missing, joined with ', '>'; 'no available provider metadata for the active-step capability'; invalid-input.",
  "cases": [
    {
      "id": "H2-future-step-not-suggested",
      "kind": "valid",
      "input": {
        "activeStep": { "id": "verify-docs", "stepType": "verification" },
        "neededCapabilities": ["outline-confirmation"],
        "availableProviderMetadata": [
          { "providerId": "fixture-future-outline", "capabilities": ["outline-confirmation"], "stepTypes": ["doc-change"], "requiresHostCapabilities": [], "locator": { "kind": "binding", "id": "to-spec" } }
        ],
        "hostCapabilities": []
      },
      "expected": {
        "suggestions": [],
        "unavailable": [{ "capability": "outline-confirmation", "reason": "no available provider metadata for the active-step capability" }]
      }
    },
